generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per sellable combination (shape/size/material/finish), matching
// how the site actually prices things — the same structure as the Excel
// sheet this replaces, so export is a direct column-for-column mapping.
model ProductRow {
  id                String   @id @default(uuid())
  productCode       String   @map("product_code")
  productName       String   @map("product_name")
  category          String
  shape             String?
  size              String
  material          String?
  finish            String?
  price             Decimal  @db.Decimal(12, 2)
  compareAtPrice    Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  startingStock     Int      @map("starting_stock")
  description       String?
  mainImageUrl      String   @map("main_image_url")
  additionalImageUrls String? @map("additional_image_urls")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([productCode])
  @@map("product_rows")
}
